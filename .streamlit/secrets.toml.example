# Copy to .streamlit/secrets.toml (local) or paste into Streamlit Cloud > Settings > Secrets.
# Users never see these. Only you, the app owner, set them.

# AI that reads timetables
PROVIDER = "gemini"          # or "claude"
API_KEY = "your-key-here"
# MODEL = "gemini-3.8-flash" # optional. If missing or retired, the app picks the newest Flash model

# Protect your free quota (optional, these are the defaults)
# READS_PER_VISIT = 5        # fresh AI reads one visitor can do
# READS_PER_DAY = 300        # fresh AI reads for the whole app per day

# Google Calendar button (optional). See "Set up Google sign-in" in README.
# GOOGLE_CLIENT_ID = "1234-abc.apps.googleusercontent.com"
# GOOGLE_CLIENT_SECRET = "GOCSPX-..."
# GOOGLE_REDIRECT_URI = "http://localhost:8501"   # on Streamlit Cloud: "https://your-app.streamlit.app"
